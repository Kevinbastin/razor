# Razorpay test-mode credentials — generate in the Razorpay Dashboard.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Application configuration
APP_ENV=development
LOG_LEVEL=INFO
CONSOLE_USERNAME=demo
CONSOLE_PASSWORD=demo
MERCHANT_ID=demo-merchant

# Razorpay hosts. Leave TPAP blank unless provisioned by Razorpay/the bank.
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_TPAP_BASE_URL=
RAZORPAY_WEBHOOK_SECRET=

# Required only for scripts/test_razorpay_testmode.py. Obtain the TPAP payload
# shape and a test dispute ID from your provisioned Razorpay test account.
RAZORPAY_TEST_MANDATE_PAYLOAD=
RAZORPAY_TEST_PAUSE_PAYLOAD=
RAZORPAY_TEST_UMN=
RAZORPAY_TEST_DISPUTE_ID=

# Generate locally with: openssl rand -hex 32
AUDIT_HMAC_SECRET=

# Optional: strictly grounded Layer 4 narrative generation.
OPENAI_API_KEY=
OPENAI_NARRATIVE_MODEL=

# Same-origin console settings and local process safeguards.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
API_RATE_LIMIT_PER_MINUTE=120
ACTION_RATE_LIMIT_PER_MINUTE=20
AUDIT_RETENTION_DAYS=90

# Console actions are safely simulated and persisted locally until TPAP and
# dispute test payloads are provisioned. Never set this to imply live action.
CONSOLE_DEMO_MODE=true
